---
// Custom PageTitle that includes bookmark and edit buttons
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/PageTitle.astro';
import BookmarkButton from './BookmarkButton.astro';
import EditButton from './EditButton.astro';
---

<div class="page-title-wrapper">
  <Default {...Astro.props}><slot /></Default>
  <div class="page-actions" data-pagefind-ignore data-site-graph-ignore>
    <EditButton {...Astro.props} />
    <BookmarkButton />
  </div>
</div>

<style>
  .page-title-wrapper {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .page-title-wrapper :global(h1) {
    flex: 1;
    min-width: 0;
  }

  .page-actions {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
    margin-top: 0.25rem;
  }
</style>
