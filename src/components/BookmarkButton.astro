---
// Bookmark button for favoriting pages
---

<button class="bookmark-btn" id="bookmark-btn" title="Bookmark this page" aria-label="Bookmark this page">
  <svg class="bookmark-icon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
  </svg>
  <svg class="bookmark-icon-filled" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
    <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
  </svg>
</button>

<style>
  .bookmark-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    cursor: pointer;
    color: var(--sl-color-text-accent);
    transition: all 0.2s;
  }

  .bookmark-btn:hover {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-accent);
  }

  .bookmark-btn.bookmarked {
    color: var(--sl-color-accent);
    background: var(--sl-color-accent-low);
  }

  .bookmark-btn.bookmarked .bookmark-icon {
    display: none;
  }

  .bookmark-btn.bookmarked .bookmark-icon-filled {
    display: block;
  }

  .bookmark-btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }
</style>

<script>
  async function initBookmarkButton() {
    const btn = document.getElementById('bookmark-btn') as HTMLButtonElement;
    if (!btn) return;

    const pagePath = window.location.pathname;

    // Check if user is authenticated
    try {
      const authResponse = await fetch('/api/auth/me');
      const authData = await authResponse.json();

      if (!authData.authenticated) {
        btn.title = 'Login to bookmark pages';
        btn.addEventListener('click', () => {
          window.location.href = `/api/auth/login?return_to=${encodeURIComponent(pagePath)}`;
        });
        return;
      }

      // Check if page is bookmarked
      const bookmarkResponse = await fetch(`/api/bookmarks?path=${encodeURIComponent(pagePath)}`);
      if (bookmarkResponse.ok) {
        const bookmarkData = await bookmarkResponse.json();
        if (bookmarkData.bookmarked) {
          btn.classList.add('bookmarked');
          btn.title = 'Remove bookmark';
        }
      }

      // Toggle bookmark on click
      btn.addEventListener('click', async () => {
        btn.disabled = true;
        const isBookmarked = btn.classList.contains('bookmarked');

        try {
          if (isBookmarked) {
            // Remove bookmark
            const response = await fetch(`/api/bookmarks?path=${encodeURIComponent(pagePath)}`, {
              method: 'DELETE',
            });
            if (response.ok) {
              btn.classList.remove('bookmarked');
              btn.title = 'Bookmark this page';
            }
          } else {
            // Add bookmark
            const response = await fetch('/api/bookmarks', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                page_path: pagePath,
                page_title: document.title,
              }),
            });
            if (response.ok) {
              btn.classList.add('bookmarked');
              btn.title = 'Remove bookmark';
            }
          }
        } catch (error) {
          console.error('Failed to toggle bookmark:', error);
        } finally {
          btn.disabled = false;
        }
      });
    } catch (error) {
      console.error('Failed to init bookmark button:', error);
    }
  }

  initBookmarkButton();
  document.addEventListener('astro:page-load', initBookmarkButton);
</script>
