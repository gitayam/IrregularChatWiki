---
// Edit button for editing pages via in-page editor

// Get the current page path from the URL
const pathname = Astro.url.pathname;
// Convert URL path to edit page path (e.g., /ai-ml/ -> ai-ml)
const pagePath = pathname.replace(/^\//, '').replace(/\/$/, '') || 'index';
// Use underscore prefix to avoid site-graph plugin indexing, hash for page path
const editUrl = `/_edit#${pagePath}`;
---

<a href={editUrl} class="edit-btn" title="Edit this page" aria-label="Edit this page" data-no-graph>
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
      <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
    </svg>
</a>

<style>
  .edit-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    color: var(--sl-color-text-accent);
    text-decoration: none;
    transition: all 0.2s;
  }

  .edit-btn:hover {
    background: var(--sl-color-gray-5);
    color: var(--sl-color-accent);
  }
</style>
